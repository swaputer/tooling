{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swaputer.invalid/schema/testnet-release-v1.json",
  "title": "Swaputer unaudited zero-value testnet release configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "environment", "releaseStatus", "chainId", "networkName",
    "poolManager", "factory", "vm", "token", "pool", "salts", "predicted",
    "liquidityPlan", "finality", "rpcEnvironmentVariables", "manifestPublisher",
    "containsPlaceholders"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "environment": { "enum": ["local", "testnet"] },
    "releaseStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auditStatus", "auditCandidateTag", "auditCandidateCommit", "economicValue", "publicMainnetDeploymentAllowed"],
      "properties": {
        "auditStatus": { "const": "unaudited" },
        "auditCandidateTag": { "const": "swaputer-v1.1-stage7c-rc2" },
        "auditCandidateCommit": { "const": "afa54c2e02e7e91430b14b6884faff5e3f5867d9" },
        "economicValue": { "const": "none" },
        "publicMainnetDeploymentAllowed": { "const": false }
      }
    },
    "chainId": { "type": "integer", "minimum": 1 },
    "networkName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "poolManager": { "$ref": "#/$defs/codeIdentity" },
    "factory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "kernelCreationCodeStore", "hookCreationCodeStore", "artifactHashes", "initCodeHashes"],
      "properties": {
        "address": { "$ref": "#/$defs/address" },
        "kernelCreationCodeStore": { "$ref": "#/$defs/store" },
        "hookCreationCodeStore": { "$ref": "#/$defs/store" },
        "artifactHashes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["factoryCreationCode", "factoryRuntime", "routerRuntime", "gasTokenCreationCode", "gasTokenRuntime", "kernelCreationCode", "kernelRuntime", "hookCreationCode", "hookRuntime", "worldDeployerCreationCode", "worldDeployerRuntime", "referenceRegistryRuntime"],
          "properties": {
            "factoryCreationCode": { "$ref": "#/$defs/bytes32" },
            "factoryRuntime": { "$ref": "#/$defs/bytes32" },
            "routerRuntime": { "$ref": "#/$defs/bytes32" },
            "gasTokenCreationCode": { "$ref": "#/$defs/bytes32" },
            "gasTokenRuntime": { "$ref": "#/$defs/bytes32" },
            "kernelCreationCode": { "$ref": "#/$defs/bytes32" },
            "kernelRuntime": { "$ref": "#/$defs/bytes32" },
            "hookCreationCode": { "$ref": "#/$defs/bytes32" },
            "hookRuntime": { "$ref": "#/$defs/bytes32" },
            "worldDeployerCreationCode": { "$ref": "#/$defs/bytes32" },
            "worldDeployerRuntime": { "$ref": "#/$defs/bytes32" },
            "referenceRegistryRuntime": { "$ref": "#/$defs/bytes32" }
          }
        },
        "initCodeHashes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gasToken", "worldDeployer", "hook"],
          "properties": {
            "gasToken": { "$ref": "#/$defs/bytes32" },
            "worldDeployer": { "$ref": "#/$defs/bytes32" },
            "hook": { "$ref": "#/$defs/bytes32" }
          }
        }
      }
    },
    "vm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byteGasPrice", "maxByteGasLimit"],
      "properties": {
        "byteGasPrice": { "$ref": "#/$defs/uintString" },
        "maxByteGasLimit": { "type": "integer", "minimum": 1, "maximum": 1000000 }
      }
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initialSupply", "initialHolder", "distributionCommitment", "decimals"],
      "properties": {
        "initialSupply": { "$ref": "#/$defs/uintString" },
        "initialHolder": { "$ref": "#/$defs/address" },
        "distributionCommitment": { "$ref": "#/$defs/bytes32" },
        "decimals": { "const": 18 }
      }
    },
    "pool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fee", "tickSpacing", "initialSqrtPriceX96"],
      "properties": {
        "fee": { "type": "integer", "minimum": 0, "maximum": 999999 },
        "tickSpacing": { "type": "integer", "minimum": 1, "maximum": 32767 },
        "initialSqrtPriceX96": { "$ref": "#/$defs/uintString" }
      }
    },
    "salts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokenSalt", "bootstrapSalt", "hookSalt"],
      "properties": {
        "tokenSalt": { "$ref": "#/$defs/bytes32" },
        "bootstrapSalt": { "$ref": "#/$defs/bytes32" },
        "hookSalt": { "$ref": "#/$defs/bytes32" }
      }
    },
    "predicted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worldDeployer", "kernel", "hook", "token"],
      "properties": {
        "worldDeployer": { "$ref": "#/$defs/address" },
        "kernel": { "$ref": "#/$defs/address" },
        "hook": { "$ref": "#/$defs/address" },
        "token": { "$ref": "#/$defs/address" }
      }
    },
    "liquidityPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "maximumProjectToken", "maximumProjectNativeWei", "thirdPartyFundsAllowed"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "maximumProjectToken": { "$ref": "#/$defs/uintString" },
        "maximumProjectNativeWei": { "$ref": "#/$defs/uintString" },
        "thirdPartyFundsAllowed": { "const": false }
      }
    },
    "finality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmations", "maximumReorgDepth", "pollIntervalSeconds"],
      "properties": {
        "confirmations": { "type": "integer", "minimum": 0 },
        "maximumReorgDepth": { "type": "integer", "minimum": 1 },
        "pollIntervalSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "rpcEnvironmentVariables": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
    },
    "manifestPublisher": { "type": "string", "minLength": 1 },
    "containsPlaceholders": { "type": "boolean" }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "bytes32": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "uintString": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "codeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "expectedExtcodehash"],
      "properties": {
        "address": { "$ref": "#/$defs/address" },
        "expectedExtcodehash": { "$ref": "#/$defs/bytes32" }
      }
    },
    "store": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "runtimeCodeHash", "payloadHash"],
      "properties": {
        "address": { "$ref": "#/$defs/address" },
        "runtimeCodeHash": { "$ref": "#/$defs/bytes32" },
        "payloadHash": { "$ref": "#/$defs/bytes32" }
      }
    }
  }
}
