{
  "manifest_version": 3,
  "name": "Swaputer Inspector",
  "version": "0.1.1",
  "description": "Recognize and strictly decode verified Swaputer executions on Ethereum explorers.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": [
    "https://ethereum-rpc.publicnode.com/*",
    "https://eth.llamarpc.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://etherscan.io/tx/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open Swaputer Inspector"
  }
}
