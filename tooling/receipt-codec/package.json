{
  "name": "@swaputer-labs/receipt-codec",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/generate-constants.mjs --check && node scripts/materialize-fixtures.mjs --check && tsc -p tsconfig.json",
    "typecheck": "node scripts/generate-constants.mjs --check && node scripts/materialize-fixtures.mjs --check && tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "generate:constants": "node scripts/generate-constants.mjs",
    "generate:fixtures": "node scripts/materialize-fixtures.mjs",
    "check:manifests": "node scripts/check-freeze-manifests.mjs"
  },
  "devDependencies": {
    "@noble/hashes": "1.7.1",
    "@types/node": "22.10.2",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
