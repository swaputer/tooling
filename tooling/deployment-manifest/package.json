{
  "name": "@swaputer/deployment-manifest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "swaputer-manifest": "./dist/src/cli.js",
    "swaputer-release": "./dist/src/release-cli.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "audit": "npm audit"
  },
  "dependencies": {
    "@noble/curves": "1.8.1",
    "@noble/hashes": "1.7.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=22"
  }
}
